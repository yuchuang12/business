# Copy to infra/staging/.env and replace the password before use.
# This file is intentionally ignored by Git.
POSTGRES_DB=business
POSTGRES_USER=runtime
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_PORT=5432

# The local Compose database does not terminate TLS. Managed staging databases
# must use require or verify-full instead.
PGSSLMODE=disable
